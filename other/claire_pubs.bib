@incollection{Altizer2019,
	title = {Animal {Migration} and {Parasitism}},
	volume = {2},
	copyright = {All rights reserved},
	isbn = {978-0-12-809633-8},
	doi = {10.1016/B978-0-12-809633-8.90708-8},
	abstract = {© 2019 Elsevier Ltd. Animal migration is geographically and taxonomically widespread, and has important ecological consequences, including for host-parasite interactions. Migration can increase host exposure to diverse parasite species, and long-distance movement of hosts can facilitate pathogen dispersal. However, for many animal species, migration reduces infection prevalence through seasonal escape from transmission sites, and owing to the loss of infected individuals during strenuous migratory journeys. In response to environmental change, some animal species now travel shorter distances or have stopped migrating altogether, lending urgency to ecological studies of the consequences of migratory behavior for parasitism.},
	booktitle = {Encyclopedia of {Animal} {Behavior}},
	publisher = {Elsevier, Academic Press},
	author = {Altizer, Sonia and Teitelbaum, Claire S and Hall, Richard J.},
	editor = {Choe, J.C.},
	year = {2019},
	keywords = {Transmission, Disease ecology, Animal movement, Immunity, Behavior, Global change, virulence, Energetics, Host-parasite dynamics},
	pages = {756--763},
}

@article{Teitelbaum2019,
	title = {Beyond migration: causes and consequences of nomadic animal movements},
	volume = {34},
	copyright = {All rights reserved},
	issn = {01695347},
	doi = {https://doi.org/10.1016/j.tree.2019.02.005},
	abstract = {© 2019 Elsevier Ltd Recent advances in animal tracking reveal that many species display irregular movements that do not fall into classical categories of movement patterns such as range residency or migration. Here, we develop a unifying framework that distinguishes these nomadic movements based on their patterns, drivers, and mechanisms. Though they occur in diverse taxa and geographic regions, nomadic movements are united by both their underlying environmental drivers, mainly environmental stochasticity, and the resulting irregular, far-ranging movement patterns. The framework further classifies types of nomadic movements, including full, seasonal, phase, irruptive, and partial nomadism. Nomadic movements can have unique effects on populations, communities, and ecosystems, most notably providing intermittent disturbances and novel introductions of propagules.},
	number = {6},
	journal = {Trends in Ecology \& Evolution},
	author = {Teitelbaum, Claire S and Mueller, Thomas},
	year = {2019},
	note = {Number: 6},
	keywords = {dispersal, environmental stochasticity, landscape dynamics, range residency, resource availability},
	pages = {569--581},
}

@article{Teitelbaum2015,
	title = {How far to go? {Determinants} of migration distance in land mammals},
	volume = {18},
	copyright = {All rights reserved},
	issn = {1461023X},
	doi = {10.1111/ele.12435},
	abstract = {© 2015 John Wiley \& Sons Ltd/CNRS. Animal migration is a global phenomenon, but few studies have examined the substantial within- and between-species variation in migration distances. We built a global database of 94 land migrations of large mammalian herbivore populations ranging from 10 to 1638 km. We examined how resource availability, spatial scale of resource variability and body size affect migration distance among populations. Resource availability measured as normalised difference vegetation index had a strong negative effect, predicting a tenfold difference in migration distances between low- and high-resource areas and explaining 23\% of the variation in migration distances. We found a weak, positive effect of the spatial scale of resource variability but no effect of body size. Resource-poor environments are known to increase the size of mammalian home ranges and territories. Here, we demonstrate that for migratory populations as well, animals living in resource-poor environments travel farther to fulfil their resource needs.},
	number = {6},
	journal = {Ecology Letters},
	author = {Teitelbaum, Claire S. and Fagan, William F. and Fleming, Chris H. and Dressler, Gunnar and Calabrese, Justin M. and Leimgruber, Peter and Mueller, Thomas},
	year = {2015},
	note = {Number: 6},
	keywords = {Ungulates, Migration distance, Foraging resources, Land migrations, Mammalian herbivores, Normalised difference vegetation index, Scaling relationships},
	pages = {545--552},
	file = {Full Text PDF:/Users/cst80488/Zotero/storage/J6P4UUJG/Teitelbaum et al. - 2015 - How far to go Determinants of migration distance in land mammals.pdf:application/pdf},
}

